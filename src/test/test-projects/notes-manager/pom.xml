<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.notesmanager</groupId>
  <artifactId>notes-manager</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>notes-manager</name>
  <description>Notes Manager application</description>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <reins.plugin.version>0.0.1-SNAPSHOT</reins.plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/reins</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>br.com.dizeno</groupId>
        <artifactId>reins-nlce-plugin</artifactId>
        <version>${reins.plugin.version}</version>
        <configuration>
          <provider>ollama</provider>
          <ollama>
            <model>glm-5.2</model>
            <endpoint>https://ollama.com</endpoint>
            <apiKey>${env.OLLAMA_API_KEY}</apiKey>
            <timeoutSeconds>600</timeoutSeconds>
            <retryAttempts>5</retryAttempts>
            <options>
              <temperature>0.2</temperature>
            </options>
          </ollama>
          <tracking>
            <freezeState>false</freezeState>
          </tracking>
          <context>
            <referencesTree>
              <attachFiles>true</attachFiles>
              <depth>*</depth>
            </referencesTree>
            <sources>
              <source>
                <file>compilation/java-console.md</file>
              </source>
            </sources>
            <cachedContent>false</cachedContent>
            <compiledFiles>true</compiledFiles>
            <inspectedFiles>false</inspectedFiles>
          </context>
          <sources>
            <main>src/main/nl</main>
          </sources>
          <target>
            <main>target/generated-sources/reins</main>
          </target>
          <reasoning>
            <maxTurns>10</maxTurns>
            <thinkingOutLoud>false</thinkingOutLoud>
            <logSystemContext>false</logSystemContext>
            <enableReasoningLog>true</enableReasoningLog>
          </reasoning>
          <includePattern>**/*.md</includePattern>
          <failOnError>true</failOnError>
          <verbose>true</verbose>
          <tooling>
            <main>list_compiled</main>
            <target>list, read, write, delete</target>
            <addReasoningNotes>true</addReasoningNotes>
            <scriptPath>compilation/scripts</scriptPath>
          </tooling>
          <recompileOn>
            <markdownReferences>true</markdownReferences>
          </recompileOn>
          <logging>
            <scriptsEvents>false</scriptsEvents>
            <eagerlyProvided>false</eagerlyProvided>
            <fileListingAndReading>false</fileListingAndReading>
            <fileMutating>false</fileMutating>
            <scriptRun>false</scriptRun>
            <selectionReason>false</selectionReason>
            <result>false</result>
            <trackingFile>false</trackingFile>
            <llmProvider>false</llmProvider>
          </logging>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.build.directory}</directory>
              <excludes>
                <exclude>generated-sources/reins/**</exclude>
              </excludes>
            </fileset>
          </filesets>
          <excludeDefaultDirectories>true</excludeDefaultDirectories>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
